# Copiá este archivo como .env.local y completá los valores.

# URL pública del sitio (links compartidos, SEO y regreso desde Mercado Pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago: Access Token de tu cuenta (Tus integraciones > Credenciales).
# Para probar usá el de pruebas. Sin esta variable, en desarrollo el pago se simula.
MP_ACCESS_TOKEN=

# Aviso por mail de cada pedido nuevo, con Resend (https://resend.com). Es opcional.
RESEND_API_KEY=
ORDERS_TO_EMAIL=
# Remitente con dominio verificado en Resend. Si queda vacío se usa onboarding@resend.dev
ORDERS_FROM_EMAIL=
